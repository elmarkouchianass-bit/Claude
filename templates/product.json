{
  "sections": {
    "main": {
      "type": "product-information",
      "settings": {
        "content_width": "content-center-aligned",
        "desktop_media_position": "left",
        "equal_columns": false,
        "gap": 32,
        "enable_sticky_add_to_cart": true,
        "padding-block-start": 16,
        "padding-block-end": 48
      },
      "blocks": {
        "media-gallery": {
          "type": "_product-media-gallery",
          "static": true,
          "settings": {
            "media_presentation": "grid",
            "media_columns": "one",
            "image_gap": 4,
            "large_first_image": false,
            "slideshow_controls_style": "counter",
            "slideshow_mobile_controls_style": "thumbnails",
            "thumbnail_position": "bottom",
            "thumbnail_width": 56,
            "thumbnail_radius": 0,
            "aspect_ratio": "adapt",
            "media_fit": "contain",
            "media_radius": 0,
            "zoom": true,
            "video_loop": false,
            "hide_variants": true
          }
        },
        "product-details": {
          "type": "_product-details",
          "static": true,
          "settings": {
            "width": "fill",
            "height": "fit",
            "details_position": "flex-start",
            "gap": 4,
            "sticky_details_desktop": true,
            "border": "none",
            "padding-block-start": 8,
            "padding-block-end": 24
          },
          "blocks": {
            "breadcrumb": {
              "type": "vrn-breadcrumb",
              "settings": {
                "padding-block-end": 8
              }
            },
            "title": {
              "type": "text",
              "settings": {
                "text": "<h1>{{ closest.product.title }}</h1>",
                "type_preset": "h2",
                "alignment": "left"
              }
            },
            "price": {
              "type": "price",
              "settings": {
                "type_preset": "h5",
                "alignment": "left",
                "show_tax_info": false,
                "show_sale_price_first": true
              }
            },
            "size_fit": {
              "type": "vrn-size-fit",
              "settings": {
                "fallback_value": 3,
                "show_label": true,
                "padding-block-start": 16,
                "padding-block-end": 8
              }
            },
            "variant_picker": {
              "type": "variant-picker",
              "settings": {
                "variant_style": "buttons",
                "show_swatches": true,
                "padding-block-start": 0,
                "padding-block-end": 4
              }
            },
            "size_guide": {
              "type": "popup-link",
              "settings": {
                "heading": "Maattabel",
                "behavior": "modal",
                "type_preset": "h6",
                "padding-block-start": 0,
                "padding-block-end": 12
              },
              "blocks": {
                "chart": {
                  "type": "vrn-metafield-text",
                  "settings": {
                    "namespace": "custom",
                    "key": "size_chart",
                    "fallback": "<p>Vul het metafield custom.size_chart met de maattabel van dit product.</p>",
                    "use_description": false
                  }
                }
              },
              "block_order": [
                "chart"
              ]
            },
            "buy_buttons": {
              "type": "buy-buttons",
              "settings": {
                "show_pickup_availability": true,
                "padding-block-start": 0,
                "padding-block-end": 0
              },
              "blocks": {
                "add-to-cart": {
                  "type": "add-to-cart",
                  "static": true,
                  "settings": {
                    "style_class": "button"
                  }
                },
                "accelerated-checkout": {
                  "type": "accelerated-checkout",
                  "static": true
                }
              },
              "block_order": []
            },
            "discount_line": {
              "type": "vrn-discount-line",
              "settings": {
                "padding-block-start": 8,
                "padding-block-end": 16
              }
            },
            "usp": {
              "type": "vrn-usp-list",
              "settings": {
                "columns": 1,
                "padding-block-start": 8,
                "padding-block-end": 16
              },
              "blocks": {
                "usp_returns": {
                  "type": "vrn-usp-item",
                  "settings": {
                    "title": "30 dagen retourrecht",
                    "body": "Past niet? Stuur het gratis terug."
                  }
                },
                "usp_shipping": {
                  "type": "vrn-usp-item",
                  "settings": {
                    "title": "Gratis verzending vanaf € 75",
                    "body": "Daaronder € 4,95 binnen Nederland."
                  }
                },
                "usp_fast": {
                  "type": "vrn-usp-item",
                  "settings": {
                    "title": "Besteld voor 22:00, morgen verzonden",
                    "body": "Op werkdagen."
                  }
                },
                "usp_service": {
                  "type": "vrn-usp-item",
                  "settings": {
                    "title": "Klantenservice in Nederland",
                    "body": "Op werkdagen bereikbaar van 9 tot 17 uur."
                  }
                }
              },
              "block_order": [
                "usp_returns",
                "usp_shipping",
                "usp_fast",
                "usp_service"
              ]
            },
            "accordion": {
              "type": "accordion",
              "settings": {
                "icon": "plus",
                "dividers": true,
                "type_preset": "h6"
              },
              "blocks": {
                "row_description": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Productomschrijving",
                    "open_by_default": true
                  },
                  "blocks": {
                    "body": {
                      "type": "product-description",
                      "settings": {
                        "type_preset": "rte"
                      }
                    }
                  },
                  "block_order": [
                    "body"
                  ]
                },
                "row_material": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Materiaal & onderhoud",
                    "open_by_default": false
                  },
                  "blocks": {
                    "body": {
                      "type": "vrn-metafield-text",
                      "settings": {
                        "namespace": "custom",
                        "key": "material_care",
                        "fallback": "<p>Vul per product het metafield custom.material_care met samenstelling en wasvoorschrift.</p>",
                        "use_description": false
                      }
                    }
                  },
                  "block_order": [
                    "body"
                  ]
                },
                "row_shipping": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Verzending",
                    "open_by_default": false
                  },
                  "blocks": {
                    "body": {
                      "type": "vrn-metafield-text",
                      "settings": {
                        "namespace": "custom",
                        "key": "shipping",
                        "fallback": "<p>Besteld voor 22:00 op werkdagen, dezelfde dag verzonden. Gratis vanaf € 75, daaronder € 4,95 binnen Nederland. België € 6,95.</p>",
                        "use_description": false
                      }
                    }
                  },
                  "block_order": [
                    "body"
                  ]
                },
                "row_returns": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Retourneren",
                    "open_by_default": false
                  },
                  "blocks": {
                    "body": {
                      "type": "vrn-metafield-text",
                      "settings": {
                        "namespace": "custom",
                        "key": "returns",
                        "fallback": "<p>30 dagen bedenktijd. Ongedragen en met het label eraan retourneren is gratis; je krijgt het aankoopbedrag binnen vijf werkdagen na ontvangst terug.</p>",
                        "use_description": false
                      }
                    }
                  },
                  "block_order": [
                    "body"
                  ]
                },
                "row_size_chart": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Maattabel",
                    "open_by_default": false
                  },
                  "blocks": {
                    "body": {
                      "type": "vrn-metafield-text",
                      "settings": {
                        "namespace": "custom",
                        "key": "size_chart",
                        "fallback": "<p>Vul het metafield custom.size_chart met de maattabel van dit product.</p>",
                        "use_description": false
                      }
                    }
                  },
                  "block_order": [
                    "body"
                  ]
                }
              },
              "block_order": [
                "row_description",
                "row_material",
                "row_shipping",
                "row_returns",
                "row_size_chart"
              ]
            }
          },
          "block_order": [
            "breadcrumb",
            "title",
            "price",
            "size_fit",
            "variant_picker",
            "size_guide",
            "buy_buttons",
            "discount_line",
            "usp",
            "accordion"
          ]
        }
      },
      "block_order": []
    },
    "recommendations": {
      "type": "product-recommendations",
      "settings": {
        "recommendation_type": "related",
        "layout_type": "grid",
        "max_products": 4,
        "carousel_on_mobile": true,
        "padding-block-start": 32,
        "padding-block-end": 64
      },
      "blocks": {
        "heading": {
          "type": "text",
          "settings": {
            "text": "<h2>Je zou ook leuk vinden</h2>",
            "type_preset": "h3"
          }
        }
      },
      "block_order": [
        "heading"
      ]
    }
  },
  "order": [
    "main",
    "recommendations"
  ]
}
