{% comment %}
  Minimal Shopify gift-card template. Required by Online Store 2.0 on every
  published theme — Shopify refuses to delete it from unpublished/dev themes.
  Shipped with every Themr build so `shopify theme dev` sync never tries to
  delete it on the remote and blow up with an "Upload Errors" banner.
{% endcomment %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>{{ 'gift_cards.issued.title' | t }}</title>
  {{ content_for_header }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>
    body { font-family: var(--font-body, system-ui, sans-serif); background: var(--color-background, #fff); color: var(--color-text, #111); margin: 0; padding: 3rem 1.5rem; }
    .gc { max-width: 520px; margin: 0 auto; text-align: center; }
    .gc__card { padding: 2.5rem 1.5rem; background: var(--color-background-card, #fff); border: 1px solid color-mix(in srgb, var(--color-text, #111) 12%, transparent); border-radius: 4px; }
    .gc__code { font-family: monospace; font-size: 1.25rem; letter-spacing: 0.18em; padding: 0.75rem 1rem; background: color-mix(in srgb, var(--color-primary, #000) 10%, transparent); border-radius: 3px; display: inline-block; margin: 1rem 0; }
    .gc__balance { font-size: 2.5rem; font-weight: 600; color: var(--color-primary, #000); margin: 0.5rem 0; }
    .gc__btn { display: inline-block; padding: 0.75rem 1.5rem; margin-top: 1.5rem; background: var(--color-primary, #000); color: #fff; text-decoration: none; border-radius: 3px; font-weight: 500; }
  </style>
</head>
<body>
  <main class="gc">
    <div class="gc__card">
      <p class="gc__eyebrow">{{ 'gift_cards.issued.subtext' | t }}</p>
      <h1 class="gc__balance">{{ gift_card.balance | money }}</h1>
      <p>{{ 'gift_cards.issued.redeem' | t: value: gift_card.initial_value | money }}</p>
      <div class="gc__code">{{ gift_card.code | format_code }}</div>
      {% if gift_card.expires_on %}
        <p>{{ 'gift_cards.issued.expires_on' | t: expiry: gift_card.expires_on }}</p>
      {% endif %}
      <a href="{{ shop.url }}" class="gc__btn">{{ 'gift_cards.issued.shop_link' | t }}</a>
    </div>
  </main>
</body>
</html>
