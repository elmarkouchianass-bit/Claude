        "content": {
          "type": "_content-without-appearance",
          "static": true,
          "settings": {
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "space-between"
          },
          "blocks": {
            "caption": {
              "type": "text",
              "name": "t:names.caption",
              "settings": {
                "text": "<p>Najaar 2026</p>",
                "type_preset": "h6"
              }
            },
            "group": {
              "type": "group",
              "settings": {
                "height": "fit"
              },
              "blocks": {
                "heading": {
                  "type": "text",
                  "name": "t:names.heading",
                  "settings": {
                    "text": "<h1>Gemaakt om te dragen</h1>",
                    "type_preset": "h1"
                  }
                },
                "text": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Jassen, knitwear en broeken van wol, katoen en canvas. Gemaakt om jaren mee te gaan, niet één seizoen.</p>",
                    "max_width": "narrow",
                    "type_preset": "rte"
                  }
                }
              },
              "block_order": [
                "heading",
                "text"
              ]
            },
            "button": {
              "type": "button",
              "settings": {
                "label": "Shop de collectie",
                "link": "shopify://collections/all",
                "style_class": "button"
              }
            }
          },
          "block_order": [
            "caption",
            "group",
            "button"
          ]
        }
      },
      "block_order": [
        "media",
        "content"
      ]
    },
