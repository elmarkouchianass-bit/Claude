{%- doc -%}
  Styles for the square bullet list used across the Vorreni blocks: USP lists, the volume
  discount ladder and rich text content. Extracted into a snippet so every block that renders
  `.vor-list` ships the same rules, also when CSS subsetting is enabled.
{%- enddoc -%}

{% stylesheet %}
  .vor-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .vor-list__item {
    position: relative;
    padding-inline-start: 1.1em;
  }

  .vor-list__item::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: calc(0.5lh - 3px);
    width: 6px;
    height: 6px;
    background-color: var(--vor-color-accent, #A34426);
  }
{% endstylesheet %}
