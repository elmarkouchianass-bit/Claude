{%- comment -%}
  Fit scale + guarantee strip.

  Params: cfg (section.settings)

  The scale answers "will this fit me?" before the shopper has to guess, and
  the guarantee directly below answers "and if it doesn't?". They are one
  block because they are one question.
{%- endcomment -%}

{%- liquid
  assign fit = cfg.fit_position | default: 'true'
  case fit
    when 'small'
      assign fit_pct = 12
      assign fit_label = cfg.fit_label_small
    when 'large'
      assign fit_pct = 88
      assign fit_label = cfg.fit_label_large
    else
      assign fit_pct = 50
      assign fit_label = cfg.fit_label_true
  endcase
-%}

<div class="assure">
  {%- if cfg.show_fit_scale -%}
    <div class="assure__fit">
      <div class="assure__fit-head">
        <span class="assure__eyebrow">{{ cfg.fit_heading | default: 'Size & fit' | escape }}</span>
        <span class="assure__fit-verdict">{{ fit_label | escape }}</span>
      </div>

      {%- comment -%}
        A slider would imply the shopper can change it. This is a readout, so
        it is a meter: the value is in the ARIA attributes and repeated in the
        verdict text above, never carried by the marker position alone.
      {%- endcomment -%}
      <div
        class="assure__track"
        role="meter"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="{{ fit_pct }}"
        aria-valuetext="{{ fit_label | escape }}"
        aria-label="{{ cfg.fit_heading | default: 'Size & fit' | escape }}"
        style="--fit: {{ fit_pct }}%"
      >
        <span class="assure__track-fill"></span>
        <span class="assure__track-knob"></span>
      </div>

      <div class="assure__scale">
        <span class="assure__scale-end{% if fit == 'small' %} is-on{% endif %}">{{ cfg.fit_label_small | escape }}</span>
        <span class="assure__scale-mid{% if fit == 'true' %} is-on{% endif %}">{{ cfg.fit_label_true | escape }}</span>
        <span class="assure__scale-end assure__scale-end--right{% if fit == 'large' %} is-on{% endif %}">{{ cfg.fit_label_large | escape }}</span>
      </div>
    </div>
  {%- endif -%}

  {%- if cfg.guarantee_text != blank -%}
    <p class="assure__promise">
      <span class="assure__promise-icon" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <polyline points="9 11.5 11.2 13.7 15.2 9.7"/>
        </svg>
      </span>
      <span>
        {%- if cfg.guarantee_lead != blank -%}
          <strong>{{ cfg.guarantee_lead | escape }}</strong>
        {%- endif -%}
        {{ cfg.guarantee_text | escape }}
      </span>
    </p>
  {%- endif -%}
</div>
