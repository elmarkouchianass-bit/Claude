{%- comment -%}
  Full-bleed image hero.

  Deliberately reuses the .hero--single-image class contract already in
  theme.css (media layer, overlay, text-shadow, white CTA treatment) so the
  hero inherits the same responsive behaviour as the other hero variants.
  Everything ENDU-specific — uppercase tracking, hairline CTAs, bottom
  alignment — comes from the :root tokens and endu.css.
{%- endcomment -%}

{%- assign img = section.settings.image -%}
{%- assign overlay = section.settings.overlay_opacity | default: 30 -%}
{%- assign hero_alt = img.alt | default: section.settings.heading -%}

<section
  class="hero hero--single-image hero--endu hero--align-{{ section.settings.text_position }}"
  style="--hero-height: {{ section.settings.height }}; --hero-dim: {{ overlay | divided_by: 100.0 }};"
  role="region"
  aria-label="{{ section.settings.heading | default: 'Featured' | escape }}"
>
  <div class="hero__media">
    {%- if img != blank -%}
      {{
        img
        | image_url: width: 2400
        | image_tag:
          class: 'hero__slide-image',
          alt: hero_alt,
          widths: '800, 1200, 1600, 2000, 2400',
          sizes: '100vw',
          fetchpriority: 'high',
          loading: 'eager'
      }}
    {%- else -%}
      <img
        class="hero__slide-image"
        src="{{ 'hero.png' | asset_url }}"
        alt="{{ section.settings.heading | escape }}"
        width="2400"
        height="1600"
        fetchpriority="high"
      >
    {%- endif -%}
  </div>

  <div class="hero__overlay"></div>

  <div class="hero__slide-content container">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="hero__heading">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="hero__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    {%- if section.settings.cta_text != blank or section.settings.cta2_text != blank -%}
      <div class="hero__actions">
        {%- if section.settings.cta_text != blank -%}
          <a
            href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}"
            class="btn btn--primary"
          >{{ section.settings.cta_text | escape }}</a>
        {%- endif -%}
        {%- if section.settings.cta2_text != blank -%}
          <a
            href="{{ section.settings.cta2_url | default: routes.all_products_collection_url }}"
            class="btn btn--outline"
          >{{ section.settings.cta2_text | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "class": "section-hero-single-image",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image", "info": "Landscape, at least 2400px wide. A lifestyle shot works better here than a packshot." },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "default": "92vh",
      "options": [
        { "value": "70vh", "label": "Short" },
        { "value": "82vh", "label": "Medium" },
        { "value": "92vh", "label": "Tall" },
        { "value": "100vh", "label": "Full screen" }
      ]
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position",
      "default": "center",
      "options": [
        { "value": "left", "label": "Bottom left" },
        { "value": "center", "label": "Bottom center" },
        { "value": "middle", "label": "Middle" }
      ]
    },
    { "type": "range", "id": "overlay_opacity", "label": "Image darkening", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 30 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Fall / Winter" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built to endure" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Essentials cut clean, in fabrics chosen to last. No logos. No seasons to chase." },
    { "type": "text", "id": "cta_text", "label": "Primary button", "default": "Shop the collection" },
    { "type": "url", "id": "cta_url", "label": "Primary button link" },
    { "type": "text", "id": "cta2_text", "label": "Secondary button", "default": "New arrivals" },
    { "type": "url", "id": "cta2_url", "label": "Secondary button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
