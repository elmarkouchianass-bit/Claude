{%- comment -%} Free single-product landing — how to use {%- endcomment -%}
{%- assign tone = section.settings.tone | default: 'light' -%}
<section class="lp-block lp-steps lp-steps--{{ tone }}" id="how" data-reveal>
  <div class="lp-wrap">
    <div class="lp-sec-head">
      {%- if section.settings.eyebrow != blank -%}<span class="lp-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    <div class="lp-steps__grid">
      {%- for block in section.blocks -%}
        <div class="lp-step" {{ block.shopify_attributes }}>
          <span class="lp-step__n">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <b>{{ block.settings.title }}</b>
          <p>{{ block.settings.desc }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Landing steps",
  "class": "section-lp-steps",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "select", "id": "tone", "label": "Tone", "options": [ { "value": "light", "label": "Light" }, { "value": "dark", "label": "Dark" } ], "default": "light" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "desc", "label": "Description" }
    ] }
  ],
  "presets": [ { "name": "Landing steps", "blocks": [ { "type": "step" }, { "type": "step" }, { "type": "step" } ] } ]
}
{% endschema %}
