<article class="article-section" data-reveal>
  <style>
    .article-section {
      padding: 4rem 0;
      max-width: 1200px;
      margin: 0 auto;
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }

    .article__back {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-family: var(--font-body);
      font-size: 0.78rem;
      font-weight: 500;
      color: var(--color-text-muted);
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 2rem;
      transition: color 0.2s ease;
    }

    .article__back:hover {
      color: var(--color-primary);
    }

    .article__header {
      max-width: 720px;
      margin: 0 auto 2.5rem;
      text-align: center;
    }

    .article__title {
      font-family: var(--font-heading);
      font-size: clamp(1.8rem, 3.5vw, 2.8rem);
      font-weight: 600;
      color: var(--color-text);
      margin: 0 0 1rem;
      line-height: 1.2;
    }

    .article__meta {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 0.5rem 1.25rem;
      font-family: var(--font-body);
      font-size: 0.82rem;
      color: var(--color-text-muted);
    }

    .article__meta-divider {
      width: 3px;
      height: 3px;
      border-radius: 50%;
      background: var(--color-text-muted);
      opacity: 0.5;
    }

    .article__tags {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      justify-content: center;
      margin-top: 1rem;
    }

    .article__tag {
      font-family: var(--font-body);
      font-size: 0.7rem;
      font-weight: 500;
      color: var(--color-primary);
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 0.3rem 0.75rem;
      border: 1px solid var(--color-border);
      border-radius: var(--btn-radius, 100px);
      transition: background 0.2s ease, color 0.2s ease;
    }

    .article__tag:hover {
      background: var(--color-primary);
      color: var(--color-background);
      border-color: var(--color-primary);
    }

    .article__featured-image {
      width: 100%;
      max-height: 500px;
      object-fit: cover;
      border-radius: var(--btn-radius, 4px);
      margin-bottom: 3rem;
    }

    .article__content {
      max-width: 720px;
      margin: 0 auto;
      font-family: var(--font-body);
      font-size: 1.05rem;
      line-height: 1.75;
      color: var(--color-text);
    }

    .article__content h2 {
      font-family: var(--font-heading);
      font-size: 1.6rem;
      font-weight: 600;
      margin: 2.5rem 0 1rem;
      color: var(--color-text);
    }

    .article__content h3 {
      font-family: var(--font-heading);
      font-size: 1.25rem;
      font-weight: 600;
      margin: 2rem 0 0.75rem;
      color: var(--color-text);
    }

    .article__content p {
      margin: 0 0 1.25rem;
    }

    .article__content a {
      color: var(--color-primary);
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    .article__content img {
      max-width: 100%;
      height: auto;
      border-radius: var(--btn-radius, 4px);
      margin: 1.5rem 0;
    }

    .article__content blockquote {
      border-left: 3px solid var(--color-primary);
      padding-left: 1.25rem;
      margin: 1.5rem 0;
      font-style: italic;
      color: var(--color-text-muted);
    }

    .article__content ul,
    .article__content ol {
      padding-left: 1.5rem;
      margin: 0 0 1.25rem;
    }

    .article__content li {
      margin-bottom: 0.4rem;
    }

    .article__comments {
      max-width: 720px;
      margin: 4rem auto 0;
      padding-top: 3rem;
      border-top: 1px solid var(--color-border);
    }

    .article__comments-title {
      font-family: var(--font-heading);
      font-size: 1.4rem;
      font-weight: 600;
      color: var(--color-text);
      margin: 0 0 2rem;
    }

    .comment {
      padding: 1.25rem 0;
      border-bottom: 1px solid var(--color-border);
    }

    .comment__meta {
      font-family: var(--font-body);
      font-size: 0.82rem;
      color: var(--color-text-muted);
      margin-bottom: 0.5rem;
    }

    .comment__author {
      font-weight: 600;
      color: var(--color-text);
    }

    .comment__body {
      font-family: var(--font-body);
      font-size: 0.95rem;
      line-height: 1.6;
      color: var(--color-text);
    }

    .comment-form {
      margin-top: 2.5rem;
    }

    .comment-form__title {
      font-family: var(--font-heading);
      font-size: 1.2rem;
      font-weight: 600;
      color: var(--color-text);
      margin: 0 0 1.25rem;
    }

    .comment-form__fields {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .comment-form__field {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .comment-form__field--full {
      grid-column: 1 / -1;
    }

    .comment-form__label {
      font-family: var(--font-body);
      font-size: 0.78rem;
      font-weight: 500;
      color: var(--color-text);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .comment-form__input,
    .comment-form__textarea {
      font-family: var(--font-body);
      font-size: 0.92rem;
      color: var(--color-text);
      background: var(--color-background);
      border: 1px solid var(--color-border);
      border-radius: var(--btn-radius, 4px);
      padding: 0.65rem 0.85rem;
      transition: border-color 0.2s ease;
    }

    .comment-form__input:focus,
    .comment-form__textarea:focus {
      outline: none;
      border-color: var(--color-primary);
    }

    .comment-form__textarea {
      min-height: 120px;
      resize: vertical;
    }

    .comment-form__submit {
      margin-top: 1rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-body);
      font-size: 0.78rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-background);
      background: var(--color-primary);
      border: none;
      border-radius: var(--btn-radius, 100px);
      padding: 0.7rem 2rem;
      cursor: pointer;
      transition: opacity 0.2s ease;
    }

    .comment-form__submit:hover {
      opacity: 0.85;
    }

    @media (max-width: 768px) {
      .article-section {
        padding: 2.5rem 0;
        padding-left: 1rem;
        padding-right: 1rem;
      }

      .comment-form__fields {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <a href="{{ blog.url }}" class="article__back">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    Back to {{ blog.title }}
  </a>

  <header class="article__header">
    <h1 class="article__title">{{ article.title }}</h1>

    <div class="article__meta">
      {%- if article.author -%}
        <span>{{ article.author }}</span>
        <span class="article__meta-divider" aria-hidden="true"></span>
      {%- endif -%}
      <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
        {{ article.published_at | date: "%B %d, %Y" }}
      </time>
    </div>

    {%- if article.tags.size > 0 -%}
      <div class="article__tags">
        {%- for tag in article.tags -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="article__tag">{{ tag }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </header>

  {%- if article.image -%}
    <img
      class="article__featured-image"
      src="{{ article.image | image_url: width: 1200 }}"
      alt="{{ article.image.alt | escape }}"
      width="1200"
      height="500"
      loading="eager"
    >
  {%- endif -%}

  <div class="article__content rte">
    {{ article.content }}
  </div>

  {%- comment -%}
    App blocks — related-product, social-proof and subscribe widgets sit
    between the article body and the comments.
  {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when '@app' -%}
        <div class="theme-app-block" {{ block.shopify_attributes }}>{% render block %}</div>
    {%- endcase -%}
  {%- endfor -%}

  {%- if blog.comments_enabled? -%}
    <div class="article__comments">
      {%- if article.comments_count > 0 -%}
        <h2 class="article__comments-title">{{ article.comments_count }} {{ article.comments_count | pluralize: 'Comment', 'Comments' }}</h2>
        {%- for comment in article.comments -%}
          <div class="comment">
            <div class="comment__meta">
              <span class="comment__author">{{ comment.author }}</span>
              &mdash;
              <time datetime="{{ comment.created_at | date: '%Y-%m-%d' }}">{{ comment.created_at | date: "%B %d, %Y" }}</time>
            </div>
            <div class="comment__body">{{ comment.content }}</div>
          </div>
        {%- endfor -%}
      {%- endif -%}

      {% form 'new_comment', article %}
        <div class="comment-form">
          <h3 class="comment-form__title">Leave a comment</h3>
          <div class="comment-form__fields">
            <div class="comment-form__field">
              <label class="comment-form__label" for="comment-author">Name</label>
              <input class="comment-form__input" type="text" id="comment-author" name="comment[author]" required>
            </div>
            <div class="comment-form__field">
              <label class="comment-form__label" for="comment-email">Email</label>
              <input class="comment-form__input" type="email" id="comment-email" name="comment[email]" required>
            </div>
            <div class="comment-form__field comment-form__field--full">
              <label class="comment-form__label" for="comment-body">Comment</label>
              <textarea class="comment-form__textarea" id="comment-body" name="comment[body]" required></textarea>
            </div>
          </div>
          <button type="submit" class="comment-form__submit">Post comment</button>
        </div>
      {% endform %}
    </div>
  {%- endif -%}
</article>

{% schema %}
{
  "name": "Article",
  "tag": "section",
  "class": "section-article",
  "blocks": [
    { "type": "@app" }
  ]
}
{% endschema %}
