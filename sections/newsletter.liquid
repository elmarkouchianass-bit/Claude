{%- comment -%} Centered signup on an inverted band. {%- endcomment -%}
<section class="newsletter{% if section.settings.invert %} newsletter--invert{% endif %}" data-reveal>
  <div class="container newsletter__inner">
    {%- if section.settings.eyebrow != blank -%}
      <span class="sec-head__eyebrow">{{ section.settings.eyebrow | escape }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="newsletter__title">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="newsletter__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="newsletter-email-{{ section.id }}">Email address</label>
      <input
        id="newsletter-email-{{ section.id }}"
        class="newsletter__input"
        type="email"
        name="contact[email]"
        placeholder="{{ section.settings.placeholder | default: 'Email address' | escape }}"
        autocomplete="email"
        required
      >
      <button type="submit" class="btn btn--primary newsletter__submit">
        {{ section.settings.button_text | default: 'Sign up' | escape }}
      </button>

      {%- if form.posted_successfully? -%}
        <p class="newsletter__note newsletter__note--ok" role="status">Thanks — check your inbox.</p>
      {%- elsif form.errors -%}
        <p class="newsletter__note newsletter__note--err" role="alert">
          {{ form.errors.translated_fields.email }} {{ form.errors.messages.email }}
        </p>
      {%- endif -%}
    {%- endform -%}

    {%- if section.settings.footnote != blank -%}
      <p class="newsletter__footnote">{{ section.settings.footnote | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "class": "section-newsletter",
  "settings": [
    { "type": "checkbox", "id": "invert", "label": "Dark band", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Stay in the loop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "First to know" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Restocks, new colorways and the occasional note on how things are made. No noise." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Email address" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Sign up" },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "Unsubscribe any time." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
