{%- paginate blog.articles by section.settings.articles_per_page -%}
<section class="blog-section" data-reveal>
  <style>
    .blog-section {
      padding: 4rem 0;
      max-width: 1200px;
      margin: 0 auto;
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }

    .blog__header {
      margin-bottom: 3rem;
      text-align: center;
    }

    .blog__title {
      font-family: var(--font-heading);
      font-size: clamp(1.8rem, 3vw, 2.8rem);
      font-weight: 600;
      color: var(--color-text);
      margin: 0;
      line-height: 1.2;
    }

    .blog__grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }

    .blog-card {
      display: flex;
      flex-direction: column;
    }

    .blog-card__image-wrap {
      position: relative;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      border-radius: var(--btn-radius, 4px);
      margin-bottom: 1.25rem;
      background: color-mix(in srgb, var(--color-text) 5%, transparent);
    }

    .blog-card__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .blog-card:hover .blog-card__image {
      transform: scale(1.03);
    }

    .blog-card__title {
      font-family: var(--font-heading);
      font-size: clamp(1.1rem, 1.8vw, 1.4rem);
      font-weight: 600;
      color: var(--color-text);
      margin: 0 0 0.5rem;
      line-height: 1.3;
    }

    .blog-card__title a {
      color: inherit;
      text-decoration: none;
      transition: opacity 0.2s ease;
    }

    .blog-card__title a:hover {
      opacity: 0.7;
    }

    .blog-card__date {
      font-family: var(--font-body);
      font-size: 0.78rem;
      color: var(--color-text-muted);
      margin-bottom: 0.75rem;
      letter-spacing: 0.02em;
    }

    .blog-card__excerpt {
      font-family: var(--font-body);
      font-size: 0.92rem;
      color: var(--color-text-muted);
      line-height: 1.6;
      margin-bottom: 1rem;
    }

    .blog-card__read-more {
      font-family: var(--font-body);
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--color-primary);
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      transition: opacity 0.2s ease;
    }

    .blog-card__read-more:hover {
      opacity: 0.7;
    }

    .blog__pagination {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.75rem;
      margin-top: 3rem;
      font-family: var(--font-body);
      font-size: 0.85rem;
    }

    .blog__pagination a,
    .blog__pagination span {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 36px;
      height: 36px;
      padding: 0 0.5rem;
      border-radius: var(--btn-radius, 4px);
      text-decoration: none;
      color: var(--color-text);
      transition: background 0.2s ease, color 0.2s ease;
    }

    .blog__pagination a:hover {
      background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    }

    .blog__pagination .is-current {
      background: var(--color-primary);
      color: var(--color-background);
      font-weight: 600;
    }

    @media (max-width: 768px) {
      .blog__grid {
        grid-template-columns: 1fr;
        gap: 2rem;
      }

      .blog-section {
        padding: 2.5rem 0;
        padding-left: 1rem;
        padding-right: 1rem;
      }
    }
  </style>

  <div class="blog__header">
    <h1 class="blog__title">{{ blog.title }}</h1>
  </div>

  <div class="blog__grid">
    {%- for article in blog.articles -%}
      <article class="blog-card" data-reveal>
        {%- if article.image -%}
          <div class="blog-card__image-wrap">
            <img
              class="blog-card__image"
              src="{{ article.image | image_url: width: 720 }}"
              alt="{{ article.image.alt | escape }}"
              width="720"
              height="405"
              loading="lazy"
            >
          </div>
        {%- endif -%}

        <h2 class="blog-card__title">
          <a href="{{ article.url }}">{{ article.title }}</a>
        </h2>

        <time class="blog-card__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
          {{ article.published_at | date: "%B %d, %Y" }}
        </time>

        <p class="blog-card__excerpt">
          {{ article.excerpt_or_content | strip_html | truncate: 150 }}
        </p>

        <a href="{{ article.url }}" class="blog-card__read-more">Read more</a>
      </article>
    {%- endfor -%}
  </div>

  {%- if paginate.pages > 1 -%}
    <nav class="blog__pagination" aria-label="Blog pagination">
      {%- if paginate.previous -%}
        <a href="{{ paginate.previous.url }}" aria-label="Previous page">&larr;</a>
      {%- endif -%}

      {%- for part in paginate.parts -%}
        {%- if part.is_link -%}
          <a href="{{ part.url }}">{{ part.title }}</a>
        {%- else -%}
          <span class="{% if forloop.index == paginate.current_page %}is-current{% endif %}">{{ part.title }}</span>
        {%- endif -%}
      {%- endfor -%}

      {%- if paginate.next -%}
        <a href="{{ paginate.next.url }}" aria-label="Next page">&rarr;</a>
      {%- endif -%}
    </nav>
  {%- endif -%}
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog posts",
  "tag": "section",
  "class": "section-blog",
  "settings": [
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Articles per page",
      "min": 4,
      "max": 24,
      "step": 2,
      "default": 8
    }
  ]
}
{% endschema %}
