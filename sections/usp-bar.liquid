{%- comment -%} Hairline row of promises. Text only — no icons, no colour. {%- endcomment -%}
<section class="usp-bar" data-reveal>
  <div class="container usp-bar__row">
    {%- for block in section.blocks -%}
      <div class="usp-bar__item" {{ block.shopify_attributes }}>
        <span class="usp-bar__title">{{ block.settings.title | escape }}</span>
        {%- if block.settings.text != blank -%}
          <span class="usp-bar__text">{{ block.settings.text | escape }}</span>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Promise bar",
  "class": "section-usp-bar",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Promise",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Free shipping" },
        { "type": "text", "id": "text", "label": "Supporting line", "default": "On U.S. orders over $75" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Promise bar",
      "blocks": [
        { "type": "item", "settings": { "title": "Free shipping", "text": "On U.S. orders over $75" } },
        { "type": "item", "settings": { "title": "30-day returns", "text": "Wear it, wash it, decide" } },
        { "type": "item", "settings": { "title": "Made to last", "text": "Heavier fabrics, honest construction" } },
        { "type": "item", "settings": { "title": "Fair pricing", "text": "Direct to you, no middleman" } }
      ]
    }
  ]
}
{% endschema %}
