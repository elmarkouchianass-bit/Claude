{%- comment -%} Free single-product landing — specs {%- endcomment -%}
{%- assign tone = section.settings.tone | default: 'dark' -%}
<section class="lp-block lp-specs lp-specs--{{ tone }}" id="how" data-reveal>
  <div class="lp-wrap lp-specs__grid">
    <div class="lp-specs__table">
      <div class="lp-sec-head lp-sec-head--left">
        {%- if section.settings.eyebrow != blank -%}<span class="lp-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
      <dl>
        {%- for block in section.blocks -%}
          {%- if block.type == 'spec' -%}
            <div class="lp-spec" {{ block.shopify_attributes }}><dt>{{ block.settings.label }}</dt><dd>{{ block.settings.value }}</dd></div>
          {%- endif -%}
        {%- endfor -%}
      </dl>
    </div>
    <div class="lp-specs__box">
      {%- if section.settings.box_title != blank -%}<h3>{{ section.settings.box_title }}</h3>{%- endif -%}
      <ul>
        {%- for block in section.blocks -%}
          {%- if block.type == 'box_item' -%}
            <li {{ block.shopify_attributes }}>{{ block.settings.label }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Landing specs",
  "class": "section-lp-specs",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "box_title", "label": "Box list title" },
    { "type": "select", "id": "tone", "label": "Tone", "options": [ { "value": "light", "label": "Light" }, { "value": "dark", "label": "Dark" } ], "default": "dark" }
  ],
  "blocks": [
    { "type": "spec", "name": "Spec row", "settings": [
      { "type": "text", "id": "label", "label": "Label" },
      { "type": "text", "id": "value", "label": "Value" }
    ] },
    { "type": "box_item", "name": "In-the-box item", "settings": [ { "type": "text", "id": "label", "label": "Item" } ] }
  ],
  "presets": [ { "name": "Landing specs" } ]
}
{% endschema %}
