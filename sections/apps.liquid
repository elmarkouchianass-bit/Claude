{%- comment -%}
  App wrapper section.

  Shopify uses this when a merchant adds an app block as its OWN section
  rather than inside an existing one (theme editor > Add section > Apps). If a
  theme ships no apps.liquid, Shopify generates an unstyled one, and the app
  renders edge-to-edge with none of the theme's width or rhythm. Shipping our
  own is the only way to control that.

  Per Shopify: this section cannot be rendered with {% section 'apps' %} and
  never appears in the section picker on its own.
  https://shopify.dev/docs/storefronts/themes/architecture/blocks/app-blocks
{%- endcomment -%}
<div class="apps-section{% if section.settings.include_padding %} apps-section--padded{% endif %}">
  {%- for block in section.blocks -%}
    <div class="theme-app-block" {{ block.shopify_attributes }}>{% render block %}</div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "App wrapper",
  "settings": [
    {
      "type": "checkbox",
      "id": "include_padding",
      "default": true,
      "label": "Match theme page margins"
    }
  ],
  "blocks": [
    { "type": "@app" }
  ],
  "presets": [
    { "name": "App wrapper" }
  ]
}
{% endschema %}
