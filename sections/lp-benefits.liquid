{%- comment -%} Free single-product landing — what it does {%- endcomment -%}
<section class="lp-block lp-does" id="does" data-reveal>
  <div class="lp-wrap lp-does__grid">
    <div class="lp-does__img">
      {%- if section.settings.media != blank -%}
        {{ section.settings.media | image_url: width: 1100 | image_tag: alt: section.settings.heading, width: 1100, height: 880, class: 'lp-img', loading: 'lazy' }}
      {%- elsif section.settings.image_url != blank -%}
        <img class="lp-img" src="{{ section.settings.image_url }}" alt="{{ section.settings.heading }}" width="1100" height="880" loading="lazy">
      {%- else -%}
        <img class="lp-img" src="{{ 'brand-story.png' | asset_url }}" alt="{{ section.settings.heading }}" width="1100" height="880" loading="lazy">
      {%- endif -%}
    </div>
    <div class="lp-does__body">
      {%- if section.settings.eyebrow != blank -%}<span class="lp-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="lp-does__heading">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- for block in section.blocks -%}
        <div class="lp-point" {{ block.shopify_attributes }}>
          <span class="lp-point__n">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <div><b>{{ block.settings.title }}</b><span>{{ block.settings.desc }}</span></div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Landing benefits",
  "class": "section-lp-does",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "image_picker", "id": "media", "label": "Image (overrides the fallback)" },
    { "type": "text", "id": "image_url", "label": "Image URL (used when no image is picked)" }
  ],
  "blocks": [
    { "type": "point", "name": "Point", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "desc", "label": "Description" }
    ] }
  ],
  "presets": [ { "name": "Landing benefits", "blocks": [ { "type": "point" }, { "type": "point" }, { "type": "point" } ] } ]
}
{% endschema %}
