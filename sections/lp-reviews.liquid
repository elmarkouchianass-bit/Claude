{%- comment -%} Free single-product landing — reviews {%- endcomment -%}
<section class="lp-block lp-reviews" id="reviews" data-reveal>
  <div class="lp-wrap">
    <div class="lp-sec-head">
      {%- if section.settings.eyebrow != blank -%}<span class="lp-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    <div class="lp-reviews__grid">
      {%- for block in section.blocks -%}
        <div class="lp-review" {{ block.shopify_attributes }}>
          <div class="lp-stars">★★★★★</div>
          <p>{{ block.settings.quote }}</p>
          <div class="lp-review__by">{{ block.settings.by }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Landing reviews",
  "class": "section-lp-reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "textarea", "id": "quote", "label": "Quote" },
      { "type": "text", "id": "by", "label": "Attribution" }
    ] }
  ],
  "presets": [ { "name": "Landing reviews", "blocks": [ { "type": "review" }, { "type": "review" }, { "type": "review" } ] } ]
}
{% endschema %}
