{
  "name": "Vorreni",
  "settings": [
    {
      "type": "header",
      "content": "Merk"
    },
    {
      "type": "paragraph",
      "content": "De accentkleur is de enige niet-neutrale kleur op de site: vierkante bullets, de actieve kortingstrede en de voortgangsbalk."
    },
    {
      "type": "color",
      "id": "vrn_accent",
      "label": "Accentkleur",
      "default": "#A6402A"
    },
    {
      "type": "header",
      "content": "Kortingsladder"
    },
    {
      "type": "paragraph",
      "content": "Maak de kortingscodes eerst aan in Kortingen. Zonder bestaande code doet een trede niets. Zie README.md voor de exacte instellingen per code."
    },
    {
      "type": "checkbox",
      "id": "vrn_ladder_enabled",
      "label": "Kortingsladder aan",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "vrn_ladder_show_collection_bar",
      "label": "Balk tonen op collectiepagina's",
      "default": true,
      "visible_if": "{{ settings.vrn_ladder_enabled }}"
    },
    {
      "type": "checkbox",
      "id": "vrn_ladder_show_drawer",
      "label": "Ladder tonen in de cart drawer",
      "default": true,
      "visible_if": "{{ settings.vrn_ladder_enabled }}"
    },
    {
      "type": "header",
      "content": "Trede 1",
      "visible_if": "{{ settings.vrn_ladder_enabled }}"
    },
    {
      "type": "checkbox",
      "id": "vrn_tier1_enabled",
      "label": "Trede 1 gebruiken",
      "default": true,
      "visible_if": "{{ settings.vrn_ladder_enabled }}"
    },
    {
      "type": "range",
      "id": "vrn_tier1_qty",
      "label": "Aantal artikelen",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 1,
      "visible_if": "{{ settings.vrn_ladder_enabled and settings.vrn_tier1_enabled }}"
    },
    {
      "type": "checkbox",
      "id": "vrn_tier1_plus",
      "label": "Dit aantal of meer",
      "default": false,
      "visible_if": "{{ settings.vrn_ladder_enabled and settings.vrn_tier1_enabled }}",
      "info": "Zet aan op de hoogste trede, zodat 5, 6, 7 … artikelen allemaal deze korting krijgen."
    },
    {
      "type": "range",
      "id": "vrn_tier1_percent",
      "label": "Korting",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "%",
      "default": 0,
      "visible_if": "{{ settings.vrn_ladder_enabled and settings.vrn_tier1_enabled }}"
    },
    {
      "type": "text",
      "id": "vrn_tier1_code",
      "label": "Kortingscode",
      "default": "",
      "visible_if": "{{ settings.vrn_ladder_enabled and settings.vrn_tier1_enabled }}",
      "info": "Laat leeg bij 0%. Moet exact overeenkomen met de code in Kortingen."
    },
    {
      "type": "header",
      "content": "Trede 2",
      "visible_if": "{{ settings.vrn_ladder_enabled }}"
    },
    {
