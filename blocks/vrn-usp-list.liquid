{% doc %}
  USP-lijst met vierkante bullets. Eén kolom op mobiel, op desktop zoveel
  kolommen als ingesteld.

  De items zijn losse `vrn-usp-item` blocks, dus ze zijn in de editor te
  verslepen, te dupliceren en te verwijderen.
{% enddoc %}

{% render 'vrn-styles' %}

<div
  class="vrn-usp-list spacing-style"
  style="{% render 'spacing-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.heading != blank -%}
    <p class="vrn-eyebrow vrn-usp-list__heading">{{ block.settings.heading }}</p>
  {%- endif -%}

  <ul
    class="vrn-usp"
    role="list"
    style="--vrn-usp-columns: {{ block.settings.columns }};"
  >
    {% content_for 'blocks' %}
  </ul>
</div>

{% stylesheet %}
  .vrn-usp-list__heading {
    margin-block-end: var(--margin-lg);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vorreni USP-lijst",
  "tag": null,
  "blocks": [
    {
      "type": "vrn-usp-item"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Kop",
      "info": "Optioneel."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Kolommen op desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Ruimte"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Boven",
      "min": 0, "max": 100, "step": 1, "unit": "px", "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Onder",
      "min": 0, "max": 100, "step": 1, "unit": "px", "default": 24
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Links",
      "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Rechts",
      "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0
    }
  ],
  "presets": [
    {
      "name": "Vorreni USP-lijst",
      "blocks": {
        "usp_returns": {
          "type": "vrn-usp-item",
          "settings": { "title": "30 dagen retourrecht", "body": "Past niet? Stuur het gratis terug." }
        },
        "usp_shipping_free": {
          "type": "vrn-usp-item",
          "settings": { "title": "Gratis verzending vanaf € 75", "body": "Daaronder € 4,95 binnen Nederland." }
        },
        "usp_shipping_fast": {
          "type": "vrn-usp-item",
          "settings": { "title": "Besteld voor 22:00, morgen verzonden", "body": "Op werkdagen." }
        },
        "usp_service": {
          "type": "vrn-usp-item",
          "settings": { "title": "Klantenservice in Nederland", "body": "Bereikbaar op werkdagen van 9 tot 17 uur." }
        }
      },
      "block_order": ["usp_returns", "usp_shipping_free", "usp_shipping_fast", "usp_service"]
    }
  ]
}
{% endschema %}
