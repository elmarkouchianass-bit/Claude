{%- doc -%}
  Vorreni USP list.

  A list of short reassurances with square bullets. Holds `_vor-usp-item` children, so every
  line can be edited, reordered and removed in the theme editor.
{%- enddoc -%}
{% render 'vor-list-styles' %}

<div
  class="vor-usp spacing-style"
  style="{% render 'spacing-style', settings: block.settings %}--vor-usp-columns: {{ block.settings.columns }};"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <p class="vor-usp__heading">{{ block.settings.heading }}</p>
  {% endif %}

  <ul class="vor-list vor-usp__items" role="list">
    {% content_for 'blocks' %}
  </ul>
</div>

{% stylesheet %}
  .vor-usp {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
    width: 100%;
  }

  .vor-usp__heading {
    margin: 0;
    font-family: var(--font-subheading--family);
    font-size: var(--font-size--2xs);
    font-weight: var(--font-subheading--weight);
    letter-spacing: var(--letter-spacing-sm);
    text-transform: uppercase;
  }

  .vor-usp__items {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-xs) var(--gap-2xl);
    font-size: var(--font-size--sm);
    line-height: var(--line-height--body-normal);
  }

  @media screen and (min-width: 750px) {
    .vor-usp__items {
      grid-template-columns: repeat(var(--vor-usp-columns, 4), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:vor.names.usp_list",
  "tag": null,
  "blocks": [
    {
      "type": "_vor-usp-item"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:vor.settings.heading"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:vor.settings.columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:vor.names.usp_list",
      "category": "t:vor.category",
      "blocks": {
        "usp-1": {
          "type": "_vor-usp-item",
          "settings": {
            "text": "t:vor.defaults.usp_1"
          }
        },
        "usp-2": {
          "type": "_vor-usp-item",
          "settings": {
            "text": "t:vor.defaults.usp_2"
          }
        },
        "usp-3": {
          "type": "_vor-usp-item",
          "settings": {
            "text": "t:vor.defaults.usp_3"
          }
        },
        "usp-4": {
          "type": "_vor-usp-item",
          "settings": {
            "text": "t:vor.defaults.usp_4"
          }
        }
      },
      "block_order": ["usp-1", "usp-2", "usp-3", "usp-4"]
    }
  ]
}
{% endschema %}
