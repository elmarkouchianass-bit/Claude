{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}{% style %}.ai-bundle-large-{{ai_gen_id}}{display:block;width:{{block.settings.desktop_width_percent}}%;max-width:100%;color:#171717;font-family:Arial,sans-serif}.ai-bundle-large-{{ai_gen_id}}__bundles{display:grid;grid-template-columns:repeat(4,1fr);gap:5px;margin:10px 0 14px}.ai-bundle-large-{{ai_gen_id}}__card{position:relative;padding-top:24px}.ai-bundle-large-{{ai_gen_id}}__badge{position:absolute;inset:0 0 auto;height:24px;background:#000;color:#fff;font-size:10px;line-height:24px;text-align:center;text-transform:uppercase;font-weight:700}.ai-bundle-large-{{ai_gen_id}}__button{width:100%;min-height:72px;background:#fff;border:1px solid #d5d5d0;border-radius:0 0 4px 4px;color:#171717}.ai-bundle-large-{{ai_gen_id}}__button[aria-pressed=true]{border-color:#000;border-bottom:4px solid #000}.ai-bundle-large-{{ai_gen_id}}__button strong,.ai-bundle-large-{{ai_gen_id}}__button small{display:block;text-transform:uppercase}.ai-bundle-large-{{ai_gen_id}}__button strong{font-size:{{block.settings.bundle_text_size}}px;line-height:1.2}.ai-bundle-large-{{ai_gen_id}}__button small{font-size:{{block.settings.detail_text_size}}px;margin-top:6px;font-weight:700;line-height:1.2}.ai-bundle-large-{{ai_gen_id}}__items{display:grid;gap:8px}.ai-bundle-large-{{ai_gen_id}}__item{border:1px solid #deded8;padding:10px;border-radius:5px}.ai-bundle-large-{{ai_gen_id}}__title,.ai-bundle-large-{{ai_gen_id}}__label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;margin-bottom:7px}.ai-bundle-large-{{ai_gen_id}}__choices{display:flex;gap:8px;flex-wrap:wrap}.ai-bundle-large-{{ai_gen_id}}__choice{background:#fff;border:1px solid #ccc;padding:5px;cursor:pointer}.ai-bundle-large-{{ai_gen_id}}__choice img{display:block;width:auto;height:72px;max-width:96px;object-fit:cover}.ai-bundle-large-{{ai_gen_id}}__choice span{display:block;font-size:11px;font-weight:700;margin-top:5px;white-space:nowrap}.ai-bundle-large-{{ai_gen_id}}__choice--size{padding:10px 13px}.ai-bundle-large-{{ai_gen_id}}__choice[aria-pressed=true]{border-color:#000;border-bottom:3px solid #000}@media(max-width:749px){.ai-bundle-large-{{ai_gen_id}}{width:100%}.ai-bundle-large-{{ai_gen_id}}__bundles{gap:3px}.ai-bundle-large-{{ai_gen_id}}__button strong{font-size:{{block.settings.mobile_bundle_text_size}}px}.ai-bundle-large-{{ai_gen_id}}__button small{font-size:{{block.settings.mobile_detail_text_size}}px}.ai-bundle-large-{{ai_gen_id}}__choice img{height:64px;max-width:82px}}{% endstyle %}<variant-bundle-large-{{ai_gen_id}} class="ai-bundle-large-{{ai_gen_id}}" {{block.shopify_attributes}}><div class="ai-bundle-large-{{ai_gen_id}}__bundles">{% for n in (1..4) %}<div class="ai-bundle-large-{{ai_gen_id}}__card">{% if n == 2 %}<div class="ai-bundle-large-{{ai_gen_id}}__badge">MOST POPULAR</div>{% elsif n == 4 %}<div class="ai-bundle-large-{{ai_gen_id}}__badge">BEST PRICE</div>{% endif %}<button type="button" class="ai-bundle-large-{{ai_gen_id}}__button" data-count="{{n}}" aria-pressed="{% if n == 1 %}true{% else %}false{% endif %}"><strong>{{n}} {% if n == 1 %}ITEM{% else %}ITEMS{% endif %}</strong><small>{% if n == 1 %}ORIGINAL PRICE{% elsif n == 2 %}10% OFF{% elsif n == 3 %}15% OFF{% else %}20% OFF{% endif %}</small></button></div>{% endfor %}</div><div class="ai-bundle-large-{{ai_gen_id}}__items"></div></variant-bundle-large-{{ai_gen_id}}><script>(function(){class B{{ai_gen_id}} extends HTMLElement{connectedCallback(){this.v={{product.variants|json}};this.o={{product.options_with_values|json}};this.box=this.querySelector('.ai-bundle-large-{{ai_gen_id}}__items');this.n=1;this.querySelectorAll('[data-count]').forEach(b=>b.onclick=()=>{this.n=+b.dataset.count;this.querySelectorAll('[data-count]').forEach(x=>x.setAttribute('aria-pressed','false'));b.setAttribute('aria-pressed','true');this.render()});this.render()}render(){this.box.innerHTML='';for(let i=0;i<this.n;i++){let r=document.createElement('div');r.className='ai-bundle-large-{{ai_gen_id}}__item';r.innerHTML='<div class="ai-bundle-large-{{ai_gen_id}}__title">ITEM '+(i+1)+'</div><div class="ai-bundle-large-{{ai_gen_id}}__label">COLOUR</div><div class="ai-bundle-large-{{ai_gen_id}}__choices c"></div><div class="ai-bundle-large-{{ai_gen_id}}__label">SIZE</div><div class="ai-bundle-large-{{ai_gen_id}}__choices s"></div>';this.box.appendChild(r);this.draw(r.querySelector('.c'),0,i);this.draw(r.querySelector('.s'),1,i)}}draw(el,o){(this.o[o]?.values||[]).forEach((x,j)=>{let v=this.v.find(z=>z.options[o]===x),b=document.createElement('button');b.type='button';b.className='ai-bundle-large-{{ai_gen_id}}__choice '+(o?'ai-bundle-large-{{ai_gen_id}}__choice--size':'');b.setAttribute('aria-pressed',j?'false':'true');if(!o&&v?.featured_image){let im=document.createElement('img');im.src=v.featured_image.src;im.alt=x;b.appendChild(im)}let t=document.createElement('span');t.textContent=x;b.appendChild(t);b.onclick=()=>{el.querySelectorAll('button').forEach(q=>q.setAttribute('aria-pressed','false'));b.setAttribute('aria-pressed','true')};el.appendChild(b)})}}customElements.define('variant-bundle-large-{{ai_gen_id}}',B{{ai_gen_id}})})();</script>{% schema %}{"name":"Larger bundle text","settings":[{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"bundle_text_size","label":"Bundle text size","min":12,"max":24,"step":1,"unit":"px","default":16},{"type":"range","id":"detail_text_size","label":"Detail text size","min":9,"max":18,"step":1,"unit":"px","default":12},{"type":"range","id":"mobile_bundle_text_size","label":"Mobile bundle text","min":10,"max":20,"step":1,"unit":"px","default":14},{"type":"range","id":"mobile_detail_text_size","label":"Mobile detail text","min":8,"max":16,"step":1,"unit":"px","default":10}],"presets":[{"name":"Larger bundle text"}],"tag":null,"class":"larger-bundle-text"}{% endschema %}